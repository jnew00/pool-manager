{
  "manifest_version": 3,
  "name": "PoolManager Number1Pool Auto-Fill",
  "version": "1.0",
  "description": "Auto-fill Number1Pool picks from your PoolManager data",

  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs"
  ],

  "host_permissions": [
    "https://number1pool.com/*",
    "https://pm.jnew.us/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://number1pool.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "PoolManager Auto-Fill"
  }
}